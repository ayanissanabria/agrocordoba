# Copy this file to .env in the project root for Docker Compose and local Flask.
# Generate each secret locally; do not commit the resulting .env file.
FLASK_SECRET_KEY=
POSTGRES_PASSWORD=

# Optional database naming and frontend port.
POSTGRES_DB=agrocordoba
POSTGRES_USER=agrocordoba
FRONTEND_PORT=3000

# Local development defaults. Set secure cookies and public URLs for HTTPS deployments.
FLASK_DEBUG=false
DATABASE_URL=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000/
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email delivery using Resend or SMTP.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
SMTP_USE_SSL=

# Optional: provision an administrator at first startup. Keep the password private.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: bearer token for the scheduled SIPSA refresh endpoint.
SIPSA_TASK_TOKEN=

# Optional: path to built frontend files when running Flask directly.
FRONTEND_DIST_DIR=
